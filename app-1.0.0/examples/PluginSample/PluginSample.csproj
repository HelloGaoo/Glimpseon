<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PluginSample</AssemblyName>
    <RootNamespace>PluginSample</RootNamespace>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GlimpseonMain">
      <HintPath>..\..\GlimpseonMain.dll</HintPath>
    </Reference>
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

</Project>
