/* 关于界面 深色 */
#about {
    background: transparent;
    border: none;
}

#about QScrollArea,
#about SmoothScrollArea,
#about #scrollWidget,
#about QWidget#scrollWidget,
#about #leftPanel,
#about #rightPanel {
    background: transparent;
    border: none;
}

/* 标题 */
#about QLabel#settingLabel {
    font-size: 33px;
    background-color: transparent;
    color: #FFFFFF;
}

/* 卡片 */
#about CardWidget {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

#about CardWidget:hover {
    background: rgba(255, 255, 255, 0.09);
}

#about CardWidget#headerCard {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

#about CardWidget#contentCard {
    border-radius: 10px;
}

/* 头部信息 */
#about QLabel#appIconLabel {
    background: transparent;
}

#about QLabel#appNameLabel {
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
}

#about QLabel#descriptionLabel {
    font-size: 14px;
    color: #CCCCCC;
    background: transparent;
}

/* 版本信息 */
#about BodyLabel#infoVersionLabel {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
}

#about CaptionLabel#infoDateLabel,
#about CaptionLabel#infoAuthorLabel {
    font-size: 13px;
    color: #888888;
    background: transparent;
}

/* 链接行 */
#about BodyLabel#linkTitleLabel {
    font-size: 14px;
    color: #EEEEEE;
    background: transparent;
}

#about CaptionLabel#linkDescLabel {
    font-size: 12px;
    color: #777777;
    background: transparent;
}

#about QLabel#versionTitle {
    font-size: 20px;
    color: #FFFFFF;
}

#about QLabel#buildDate {
    color: #CCCCCC;
    font-size: 13px;
}

#about QLabel#updateStatusIcon {
    border-radius: 8px;
    background-color: #999999;
}

#about QLabel#updateStatusLabel {
    color: #999999;
    font-size: 14px;
}

/* 更新日志 */
#about QLabel#changelogTitle {
    font-size: 16px;
    color: #FFFFFF;
}

/* 设置卡片 */
#about SettingCard,
#about SwitchSettingCard {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

#about SettingCard:hover,
#about SwitchSettingCard:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* 按钮 */
#about PrimaryPushButton {
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
    color: #FFFFFF;
}

#about PrimaryPushButton:pressed {
    color: rgba(255, 255, 255, 0.7);
}

/* 底部版权 */
#about CaptionLabel#copyrightLabel {
    font-size: 12px;
    color: #555555;
    background: transparent;
}
