<Window x:Class="Glimpseon.UI.SplashWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="160"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False">
  <Border x:Name="ContentBorder" CornerRadius="10" Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="20,15,20,10" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Image x:Name="IconImage" Width="64" Height="64" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="AppNameLabel" Text="Glimpseon" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionLabel" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="StatusLabel" FontSize="13" Opacity="0.8" />
      <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" />
    </StackPanel>
  </Border>
</Window>
